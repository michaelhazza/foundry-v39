{
  "name": "foundry",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "verify": "bash scripts/run-all-gates.sh",
    "prebuild": "npm run verify",
    "predev": "echo 'Skipping predev gates during development'",
    "dev": "PORT=3001 concurrently \"tsx watch server/index.ts\" \"cd client && npx vite\"",
    "build": "npm run db:push && tsc -p tsconfig.server.json && cd client && npx vite build",
    "start": "NODE_ENV=production PORT=5000 node dist/server/index.js",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate --force",
    "db:migrate": "tsx server/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "drizzle-orm": "^0.29.3",
    "pg": "^8.11.3",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "zod": "^3.22.4",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "react-hook-form": "^7.49.3",
    "@hookform/resolvers": "^3.3.4",
    "lucide-react": "^0.309.0",
    "date-fns": "^3.3.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.10.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "drizzle-kit": "^0.20.13",
    "vite": "^5.0.12",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.33",
    "autoprefixer": "^10.4.17"
  }
}
